      ],
      "name": "Summarize KPIs"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "regions = {}\nfor item in _items:\n  data = item['json']\n  region = data['Region']\n  if region not in regions:\n    regions[region] = {\n      'region' : region,\n      'total_sales' : 0,\n      'total_profit' : 0,\n      'total_units' : 0\n    }\n  regions[region]['total_sales'] += data['Sales']\n  regions[region]['total_profit'] += data['Profit']\n  regions[region]['total_units'] += data['Units']\n\noutput = []\nfor region_data in regions.values():\n  region_data['Profit_margin'] = (region_data['total_profit']/region_data['total_sales'])*100\n  output.append(region_data)\nreturn output\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        80
      ],
      "name": "Regional Sales Analysis"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "regions = []\nfor item in _items:\n  regions.append(item['json'])\n\nhighest_sales_region = max(regions,key=lambda region :region['total_sales'])\n\nhighest_profit_region = max(regions,key = lambda region:region['total_profit'])\n\nhighest_profit_margin = max(\n  regions,\n  key=lambda region : region['Profit_margin']\n)\n\noutput = {\n  'highest_sales_region' : highest_sales_region['region'],\n  'highest_sales' : highest_sales_region['total_sales'],\n  'highest_profit_region' : highest_profit_region['region'],\n  'highest_profit' :  highest_profit_region['total_profit'],\n  'highest_profit_margin_region' : highest_profit_margin['region'],\n  'highest_Profit_margin' : highest_profit_margin['Profit_margin']\n}\nreturn output"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        80
      ],
